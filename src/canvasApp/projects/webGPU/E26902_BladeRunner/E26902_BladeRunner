export default class E26902_BladeRunner {
    constructor() {
        this.type = 'WEBGPU_APP'
        this.profileEnabled = new URLSearchParams(location.search).get('profile') === '1'
        this.rendererOptions = { requireWebGPU: true, benchmarkOnStart: false, powerPreference: 'high-performance', trackTimestamp: this.profileEnabled }
        this.ownsMetrics = true
        this.quality = TYRELL.quality
        this.qualitySelection = 'auto'
        this.deviceSelection = 'auto'
        this.detectedDevice = detectDeviceMode({ mobileHint: navigator.userAgentData?.mobile || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent), coarsePointer: window.matchMedia('(pointer: coarse)').matches, touchPoints: navigator.maxTouchPoints })
        this.deviceMode = this.detectedDevice
        this.budgetMode = 'optimized'
        this.gpuCapacitySettings = TYRELL.gpuCapacity
        this.capacityChecks = new TyrellCapacityChecks(this.gpuCapacitySettings)
        this.samples = []
        this.transitionDuration = CAMERA_STATES.transition.duration
        this.transitionEasing = CAMERA_STATES.transition.easing
        this.cameraStates = createCameraStates(cameraStateExport, CAMERA_STATES)
        this.comparison = new TyrellComparison()
        this.disposed = false
        this.lookProfile = TYRELL.materialLook
        this.exposureEV = 0
        this.studio = false
        this.lightingProfile = TYRELL.lightingProfile
        this.vkDetailSavings = true
    }
    mount(app) {
        if (this.ui) return
        this.app = app
        document.body.classList.add('tyrell-viewer', 'tyrell-reference')
        this.ui = new TyrellUI({
            restoreCamera: () => this.selectCamera(this.activeCameraIndex),
            transitionDuration: value => { if (Number.isFinite(value)) this.transitionDuration = Math.max(0, Math.min(10, value)) },
            transitionEasing: value => { this.transitionEasing = cameraTransition({ duration: this.transitionDuration, easing: value }).easing },
            navigation: enabled => this.setNavigation(enabled),
            enterNavigation: () => this.navigation?.enter(),
            navigationHeight: value => {
                if (!this.navigation || !Number.isFinite(value)) return
                this.navigation.height = Math.max(1.2, Math.min(1.9, value))
                if (this.navigation.enabled) this.navigation.camera.position.y = this.navigation.height
            },
            navigationSpeed: value => { if (this.navigation) this.navigation.speed = Math.max(.25, Math.min(5, value)) },
            budget: mode => { if (BUDGET_MODES.includes(mode)) { this.budgetMode = mode; this.selectQuality(this.qualitySelection) } },
            probeInterval: seconds => { this.specularEnvironment?.setCaptureInterval(seconds); this.resetMetrics() },
            camera: index => this.selectCamera(index), quality: name => this.selectQuality(name),
            deviceMode: mode => this.selectDeviceMode(mode),
            vkToggle: () => this.toggleVK(),
            vkAuto: enabled => { if (this.vk) { this.vk.arrival.enabled = enabled; this.vk.arrival.cancel() } },
            vkSavings: enabled => { this.vkDetailSavings = enabled; this.resetMetrics() },
            vkChassisColor: color => { if (this.vk?.setChassisColor(color)) this.floorReflection?.updates.invalidate() },
            glassware: values => {
                this.glassware?.configure(values)
                this.floorReflection?.updates.invalidate()
            },
            frame: enabled => { document.body.classList.toggle('tyrell-reference', enabled); app.size.update(); this.resetMetrics() },
            retry: () => this.rendererError ? location.reload() : this.load(),
            capture: () => { this.captureRequested = true }, report: () => this.downloadReport(),
            pan: settings => this.configureCameraPan(settings),
            center: () => this.pan?.reset(),
            look: values => this.setLook(values),
            lighting: profile => this.setLighting(profile),
            reflection: enabled => { this.floorReflection?.setEnabled(enabled); this.syncQualityEffects(); this.resetMetrics() },
            reflectionMode: mode => { this.floorReflection?.setMode(mode); this.resetMetrics() },
            reflectionResolution: value => { this.floorReflection?.setResolution(value); this.resetMetrics() },
            reflectionUpdates: value => { this.floorReflection?.updates.setMode(value); this.resetMetrics() },
            specularEnvironment: enabled => { this.specularEnvironment?.setEnabled(enabled); this.resetMetrics() },
            volume: values => this.setVolume(values),
            post: values => { this.post?.configure(values); this.syncQualityEffects(); this.resetMetrics() },
            flare: values => { this.post?.configureFlare(values); this.resetMetrics() },
            sky: enabled => { this.sky?.setEnabled(enabled); this.resetMetrics() },
            skyHeight: value => { this.sky?.setHeightScale(value); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            skyRadial: value => { this.sky?.setRadialIntensity(value); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            city: enabled => { this.city?.setEnabled(enabled); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            cityColor: values => { this.city?.setColorHSL(values); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            cityColorBenchmark: () => this.measureCityColor(),
            buildingLights: values => { this.buildingLights?.configure(values); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            flames: values => { this.flames?.configure(values); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            nearTraffic: values => { this.nearTraffic?.configure(values); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            airTraffic: values => { this.airTraffic?.configure(values); this.floorReflection?.updates.invalidate(); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            measure: () => { if (this.developmentControls || this.navigation?.enabled || this.stageCamera?.transition) { this.ui.comparisonStatus('Selecciona una cámara fija y espera a que termine la transición.'); return } (!this.developmentControls && !this.navigation?.enabled && !this.stageCamera?.transition && this.pan?.reset()); this.resetMetrics(); this.measuring = true; this.ui.comparisonStatus('Midiendo: espera sin cambiar controles ni mover la cámara…') },
            measureSustained: () => this.startSustainedMeasurement(),
            clearMeasurements: () => { this.measuring = false; this.sustainedMeasurement = null; this.comparison.clear(); this.ui.showMeasurements([]); this.ui.comparisonStatus('Registro vacío.') },
            exportMeasurements: () => { const text = JSON.stringify({ note: 'RAF, CPU de envío y GPU de pases (opcional con profile=1). Comparar misma cámara y luz; consultar qualityBudget y resolución efectiva.', rows: this.comparison.rows }, null, 2); this.ui.showOutput(new Blob([text], { type: 'application/json' }), 'tyrell-comparacion.json', text) },
            atmosphere: values => { this.atmosphere?.configure(values); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            indirect: mode => { this.indirect?.setMode(mode); this.setLighting(this.lightingProfile) },
            contribution: value => { this.lighting?.setContribution(value); this.indirect?.apply(this.lighting, this.studio); this.specularEnvironment?.invalidate(); this.resetMetrics() }
        })
        this.ui.setPanSettings(TYRELL.pan)
        this.ui.setTransitionSettings({ duration: this.transitionDuration, easing: this.transitionEasing })
        this.ui.setEffectSettings(TYRELL.effects)
        this.ui.setSkyHeight(TYRELL.sky.heightScale)
        this.ui.setSkyRadial(TYRELL.sky.radialIntensity)
        this.ui.lightingSelect.value = this.lightingProfile
        this.ui.setLookSettings({ profile: this.lookProfile, ev: this.exposureEV, studio: this.studio })
        app.size.update()
        app.emitter.on('onAppKill', this.killListener = () => this.dispose())
    }
    onRendererProgress(app) { this.mount(app) }
    async measureGPUCapacity(renderer) {
        this.ui.status('Midiendo la capacidad de la GPU…')
        this.gpuCapacity = await measureGPUCapacity(renderer, () => this.disposed, this.gpuCapacitySettings)
        this.capacityChecks.initial(this.gpuCapacity)
        if (!this.disposed) { this.ui.setGPUCapacity(this.gpuCapacity); this.selectQuality(this.qualitySelection) }
    }
    onRendererError(error, app) {
        this.mount(app)
        this.rendererError = error
        this.ui.setBackend('WebGPU no disponible')
        this.ui.error(error, true)
    }
    init(app) {
        this.mount(app)
        this.scene = app.render.scene
        this.stageCamera = new TyrellCameraRig(app)
        this.pan = new TyrellCameraPan(this.stageCamera.get_camera(), TYRELL.pan)
        this.pointerMove = event => {
            if (event.pointerType !== 'mouse' || !this.revealed || !this.built || this.developmentControls || this.navigation?.enabled) return
            if (event.target?.closest?.('.tyrell-gui-panel footer, .tyrell-gui-toggle, .tyrell-controls, .tyrell-pan, .tyrell-look, dialog')) { this.pan.setPointer(0, 0); return }
            if (this.measuring || this.sustainedMeasurement) this.resetMetrics()
            this.pan.setPointer(event.clientX / window.innerWidth * 2 - 1, event.clientY / window.innerHeight * 2 - 1)
        }
        this.pointerLeave = () => this.pan.setPointer(0, 0)
        this.windowBlur = () => { if (!this.developmentControls && !this.navigation?.enabled) this.pan.reset(); this.panTime = undefined }
        this.cameraKeyDown = event => this.handleShortcut(event)
        window.addEventListener('keydown', this.cameraKeyDown)
        window.addEventListener('pointermove', this.pointerMove)
        document.documentElement.addEventListener('pointerleave', this.pointerLeave)
        this.renderer = app.render.renderer
        this.navigation = new TyrellNavigation(this.stageCamera.get_camera(), this.renderer.domElement,
            message => this.ui.setNavigationState(this.navigation?.enabled, this.navigation?.locked, message), () => this.ui.dialog.open)
        this.performanceProbe = new TyrellPerformance(this.renderer, this.profileEnabled)
        this.colorReference = applyColorReference(this.renderer, this.exposureEV)
        this.post = new TyrellPostProcessing(this.renderer, this.scene)
        this.renderer.shadowMap.enabled = true
        this.renderer.shadowMap.type = THREE.PCFShadowMap
        this.renderer.shadowMap.transmitted = true
        this.renderer.setClearColor(0x171512, 1)
        this.ui.setBackend(`WebGPU · Three.js r${THREE.REVISION}`)
        this.setQuality(this.quality)
        this.resizeListener = () => { this.updateQualityResolution(); this.resetMetrics() }
        app.emitter.on('onAppSizeUpdate', this.resizeListener)
        this.lifecycle = new TyrellLifecycle({
            pauseInput: () => { this.navigation?.pause(); this.pan?.setPointer(0, 0) },
            resetTiming: () => { this.panTime = undefined; this.startup?.pause(); this.resetMetrics() },
            suspend: () => app.deactivate(), resume: () => app.activate(),
            ready: () => this.built, failed: () => !!this.rendererError
        })
        this.previousDeviceLost = this.renderer.onDeviceLost
        this.deviceLost = info => {
            if (this.disposed) return
            this.previousDeviceLost?.call(this.renderer, info)
            this.rendererError = new Error('Se ha perdido la conexión con la GPU. Recarga la página para recuperar el visor.')
            this.lifecycle.pause(); app.deactivate()
            this.ui.setBackend('WebGPU · conexión interrumpida')
            this.ui.error(this.rendererError, true)
        }
        this.renderer.onDeviceLost = this.deviceLost
        this.containerObserver = new ResizeObserver(() => {
            if (!this.disposed && app.$container.clientWidth > 0 && app.$container.clientHeight > 0) app.size.update()
        })
        this.containerObserver.observe(app.$container)
        this.load()
    }
    async load() {
        this.abort?.abort()
        this.abort = new AbortController()
        this.ui.progress.hidden = false
        this.revealed = false
        this.ui.beginStartup()
        this.ui.status('Cargando la oficina Tyrell…')
        try {
            const settingsURL = new URL('config/E26902_BladeRunner/gui.initial.json', new URL(this.app.pathPrefix, document.baseURI))
            const response = await fetch(settingsURL, { signal: this.abort.signal, cache: 'no-store' })
            if (!response.ok) throw new Error(`No se pudo cargar gui.initial.json (HTTP ${response.status})`)
            this.initialGUISettings = await response.json()
            this.preparedGUISettings = prepareGUISettings(this.ui.root, this.initialGUISettings, this.cameraStates)
            this.cameraStates = applyCameraStateKeys(this.cameraStates, this.initialGUISettings.camera.stateKeys).map(state => ({ ...state,
                mousePan: cameraStatePan(this.initialGUISettings.camera.mousePan, state.cameraStateId) }))
            this.asset = await loadTyrell(new URL(TYRELL.asset, new URL(this.app.pathPrefix, document.baseURI)).href, this.abort.signal,
                (received, total, parsing) => this.ui.status(parsing ? 'Preparando geometría, materiales y cámaras…' : `Cargando escenario · ${(received / 1e6).toFixed(1)}${total ? ' / ' + (total / 1e6).toFixed(1) : ''} MB`, total ? received / total : undefined))
            if (this.disposed) { disposeScene(this.asset.gltf.scene); return }
            this.glasswareAsset = await loadTyrell(new URL(GLASSWARE_ASSET, new URL(this.app.pathPrefix, document.baseURI)).href,
                this.abort.signal, () => this.ui.status('Cargando la licorera y los vasos…'))
            if (this.disposed) { disposeScene(this.glasswareAsset.gltf.scene); disposeScene(this.asset.gltf.scene); return }
            if (new URLSearchParams(location.search).get('vk') !== '0') {
                this.vkAsset = await loadTyrell(new URL('glbs/E26902_BladeRunner/VK_Device.glb', new URL(this.app.pathPrefix, document.baseURI)).href, this.abort.signal,
                    (received, total, parsing) => this.ui.status(parsing ? 'Preparando el Voight-Kampff…' : `Cargando Voight-Kampff · ${(received / 1e6).toFixed(1)} MB`))
                if (this.disposed) { disposeScene(this.vkAsset.gltf.scene); disposeScene(this.glasswareAsset.gltf.scene); disposeScene(this.asset.gltf.scene); return }
            }
            this.skyTexture = await new THREE.TextureLoader().loadAsync(new URL(TYRELL.sky.texture, new URL(this.app.pathPrefix, document.baseURI)).href)
            this.skyTexture.colorSpace = THREE.SRGBColorSpace
            this.skyTexture.wrapS = THREE.ClampToEdgeWrapping
            if (this.disposed) { this.skyTexture.dispose(); disposeScene(this.asset.gltf.scene); disposeScene(this.glasswareAsset?.gltf.scene); disposeScene(this.vkAsset?.gltf.scene); return }
            this.app.emitter.emit('onProjectLoaded', {})
        } catch (error) {
            // A parse/build failure must leave retry without a duplicate scene.
            if (!this.vk?.group.parent) disposeScene(this.vkAsset?.gltf.scene)
            disposeScene(this.asset?.gltf.scene)
            disposeScene(this.glasswareAsset?.gltf.scene)
            this.glasswareAsset = null
            this.vkAsset = null
            this.asset = null
            if (error.name === 'AbortError' || this.disposed) return
            console.error('[Tyrell] Carga:', error)
            this.fill?.removeFromParent()
            this.ui.error(error)
        }
    }
    build() {
        this.world3D = this.asset.gltf.scene
        this.glassware = addGlassware(this.world3D, this.glasswareAsset.gltf.scene)
        this.glasswareTable = new TyrellGlasswareTable(this.world3D, this.glassware.groups)
        this.navigation.collision = new TyrellCollision(this.world3D)
        this.columnCores = addColumnCores(this.world3D)
        this.contactRepair = settleInstrumentCase(this.world3D)
        this.city = new TyrellCity(this.world3D)
        this.buildingLights = new TyrellBuildingLights(this.world3D)
        this.airTraffic = new TyrellAirTraffic(this.world3D)
        this.nearTraffic = new TyrellNearTraffic(this.world3D)
        this.flames = new TyrellFlames(this.world3D, this.city)
        this.floorReflection = new TyrellFloorReflection(this.world3D)
        this.scene.add(this.world3D)
        this.world3D.updateMatrixWorld(true)
        this.materialAudit = auditMaterialMaps(this.world3D)
        this.look = new TyrellLook(this.world3D)
        this.cameras = []
        this.modelStats = { meshes: 0, triangles: 0, cameras: 0 }
        this.world3D.traverse(object => {
            if (object.isPerspectiveCamera) this.cameras.push(object)
            if (object.isMesh) {
                this.modelStats.meshes++
                this.modelStats.triangles += (object.geometry.index?.count || object.geometry.attributes.position.count) / 3
                object.receiveShadow = true
                // Keep the distant pyramid/sky out of the room's shadow pass.
                object.getWorldPosition(_position)
                object.castShadow = !object.userData.noCastShadow && !object.name.startsWith('City /') && _position.length() < 50
                if (object.name.startsWith('City /')) object.receiveShadow = false
                const materials = Array.isArray(object.material) ? object.material : [object.material]
                for (const material of materials) {
                    if (material.name === 'Crystal' || material.userData.tyrellGlass) material.castShadowNode = vec4(.09, .065, .025, material.userData.glassShadowOpacity ?? TYRELL.shadows.glassOpacity)
                }
            }
            if (object.isDirectionalLight) {
                this.sun = object
                object.userData.exportedIntensity = object.intensity
                object.intensity = TYRELL.sunIntensity
                object.castShadow = true
                Object.assign(object.shadow.camera, TYRELL.shadows.camera)
                object.shadow.bias = TYRELL.shadows.bias
                object.shadow.normalBias = TYRELL.shadows.normalBias
                object.shadow.radius = TYRELL.shadows.radius
                object.shadow.camera.updateProjectionMatrix()
            }
        })
        this.cameras.sort((a, b) => a.name.localeCompare(b.name))
        this.city.configureCameraReferences(this.cameras)
        this.modelStats.cameras = this.cameras.length
        if (!this.cameras.length) throw new Error('El GLB no contiene cámaras de perspectiva.')
        this.fill = new THREE.HemisphereLight(0xffdab0, 0x797e8a, TYRELL.hemisphereIntensity)
        this.fill.name = 'Tyrell / relleno provisional'
        this.scene.add(this.fill)
        if (ltcUsers++ === 0) RectAreaLightNode.setLTC(RectAreaLightTexturesLib.init())
        this.usesLTC = true
        this.areaLights = TYRELL.areaFills.map(({ position, target, color, intensity, size }) => {
            const light = new THREE.RectAreaLight(color, intensity, size, size)
            light.name = 'Tyrell / área provisional'
            light.position.set(...position)
            light.lookAt(new THREE.Vector3(...target))
            this.scene.add(light)
            return light
        })
        this.lighting = new TyrellLighting(this.world3D, this.sun, this.fill, this.areaLights)
        if (this.vkAsset) {
            this.vk = new TyrellVKDevice(this.vkAsset.gltf.scene)
            this.world3D.add(this.vk.group)
            this.ui.setVKState(this.vk.motion.state)
        } else this.ui.setVKState('disabled')
        this.post.flare = new TyrellLensFlare(this.lighting.disc, () => !this.studio && this.sun.visible && this.sun.intensity > 0)
        this.indirect = new TyrellIndirect(this.scene)
        this.specularEnvironment = new TyrellSpecularEnvironment(this.scene, this.world3D, this.floorReflection)
        if (this.vk) this.specularEnvironment.register(this.vk.group, this.vk.materials)
        this.volume = new TyrellLightVolume(() => this.sun)
        this.atmosphere = new TyrellAtmosphere(this.scene, this.world3D, this.volume)
        this.sky = new TyrellSky(this.scene, this.lighting.sky, this.skyTexture, {
            ...TYRELL.sky, aspect: TYRELL.referenceAspect,
            camera: this.cameras.find(camera => /^(?:Camera|CAM)[ _]D(?:\W|$)/i.test(camera.name))
        })
        this.setLighting(this.lightingProfile)
        this.studioLights = new THREE.Group()
        this.studioLights.name = 'Tyrell / estudio de materiales'
        this.studioLights.add(new THREE.HemisphereLight(0xffffff, 0x777777, 1.2))
        for (const [position, target, intensity] of [
            [[-5, 6, -5], [0, 1, -9], 3], [[6, 4, -12], [0, 1, -8], 1.5]
        ]) {
            const light = new THREE.RectAreaLight(0xffffff, intensity, 8, 8)
            light.position.set(...position); light.lookAt(new THREE.Vector3(...target)); this.studioLights.add(light)
        }
        this.scene.add(this.studioLights)
        this.reviewBackground = []
        this.world3D.traverse(object => {
            if (object.isMesh && (object.name.startsWith('Cielo') || object.name.startsWith('Sol'))) {
                this.reviewBackground.push({ object, visible: object.visible })
            }
        })
        this.setLook({ profile: this.lookProfile, studio: this.studio })
        this.selectCameraState(this.initialGUISettings.camera.initialState)
        this.setQuality(this.quality)
        this.built = true
        // CanvasApp activates after build; run visibility reconciliation afterwards.
        queueMicrotask(() => { if (!this.disposed && document.hidden) this.lifecycle.sync() })
        this.floorReflection.setEnabled(TYRELL.effects.floorReflection)
        this.specularEnvironment.setEnabled(TYRELL.effects.specularEnvironment)
        this.atmosphere.configure({ exterior: TYRELL.effects.exterior, interior: TYRELL.effects.interior })
        this.setVolume({ enabled: TYRELL.effects.volume })
        this.post.configure({ bloom: TYRELL.effects.bloom, grade: TYRELL.effects.grade })
        applyGUISettings(this.preparedGUISettings)
        // Reproducible close-up for material/geometry review; normal startup is unchanged.
        if (new URLSearchParams(location.search).has('glasswareReview')) {
            this.stageCamera.setState({ cameraStateId: 'glassware-review',
                position: [.48, 1.14, -9.36], target: [.94, .92, -10.20],
                fov: 34, near: .01, far: 2500, mousePan: { enabled: false } })
            this.pan.setReference(this.stageCamera.baseCamera, { target: this.stageCamera.target })
            this.syncCameraPan()
        }
        this.startup = new TyrellStartup({ fadeMs: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1500 })
        this.ui.status('Estabilizando la escena con los efectos activos…')
        this.resetMetrics()
    }
    selectCameraState(cameraStateId, options = {}) {
        const index = this.cameraStates.findIndex(state => state.cameraStateId === cameraStateId)
        if (index < 0) return false
        return this.selectCamera(index, options)
    }
    handleShortcut(event) {
        if (!this.revealed || !this.built || this.disposed || event.repeat || event.isComposing || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return
        if (event.target?.isContentEditable || event.target?.closest?.('input, textarea, select, [contenteditable], [role="textbox"]') || this.ui.dialog.open) return
        if (event.key.toLowerCase() === 'c') {
            event.preventDefault()
            this.setDevelopmentCamera(!this.developmentControls)
            return
        }
        if (event.key.toLowerCase() === 'v') {
            event.preventDefault()
            this.toggleVK()
            return

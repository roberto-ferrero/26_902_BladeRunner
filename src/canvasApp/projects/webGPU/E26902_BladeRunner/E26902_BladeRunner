import * as THREE from 'three'
import { RectAreaLightNode } from 'three/webgpu'
import { RectAreaLightTexturesLib } from 'three/addons/lights/RectAreaLightTexturesLib.js'
import { TYRELL } from './config'
import { loadTyrell, disposeScene } from './TyrellAssets'
import TyrellCameraRig from './TyrellCameraRig'
import TyrellUI from './TyrellUI'
import { agxLookToneMapping, setLookEnabled } from './TyrellToneMapping'
import { createAreaFills, applySunFromMaster, fitSunShadow, createIndirect, INDIRECT_MODES } from './TyrellLighting'
import { applyBackfaceCulling } from './TyrellSurfaces'

export default class E26902_BladeRunner {
    constructor() {
        this.type = 'WEBGPU_APP'
        this.rendererOptions = { requireWebGPU: true, benchmarkOnStart: false, powerPreference: 'high-performance' }
        this.ownsMetrics = true
        this.quality = TYRELL.quality
        this.compare = false
        this.look = true
        this.indirect = TYRELL.lighting.indirect.mode
        this.samples = []
        this.disposed = false
    }
    // AppRender asks for this before every resize; null keeps the container size.
    get_renderSize() {
        if (!this.compare) return null
        return { ...TYRELL.compareSize, updateStyle: false }
    }
    mount(app) {
        if (this.ui) return
        this.app = app
        document.body.classList.add('tyrell-viewer', 'tyrell-reference')
        this.ui = new TyrellUI({
            camera: index => this.selectCamera(index), quality: name => this.setQuality(name),
            frame: enabled => { document.body.classList.toggle('tyrell-reference', enabled); app.size.update(); this.resetMetrics() },
            compare: enabled => this.setCompare(enabled),
            look: enabled => this.setLook(enabled),
            indirect: mode => this.setIndirect(mode),
            retry: () => this.rendererError ? location.reload() : this.load(),
            capture: () => { this.captureRequested = true }, report: () => this.downloadReport()
        })
        app.size.update()
        app.emitter.on('onAppKill', this.killListener = () => this.dispose())
    }
    onRendererProgress(app) { this.mount(app) }
    onRendererError(error, app) {
        this.mount(app)
        this.rendererError = error
        this.ui.setBackend('WebGPU no disponible')
        this.ui.error(error, true)
    }
    init(app) {
        this.mount(app)
        this.scene = app.render.scene
        this.stageCamera = new TyrellCameraRig(app)
        this.renderer = app.render.renderer
        // Three's stock AgX has no look; register the one Blender rendered the references with.
        this.renderer.library.addToneMapping(agxLookToneMapping, THREE.CustomToneMapping)
        this.renderer.toneMapping = THREE.CustomToneMapping
        this.renderer.toneMappingExposure = TYRELL.exposure
        this.renderer.outputColorSpace = THREE.SRGBColorSpace
        this.renderer.shadowMap.enabled = true
        this.renderer.shadowMap.type = THREE.PCFShadowMap
        this.renderer.setClearColor(0x171512, 1)
        this.ui.setBackend('WebGPU · Three.js r182')
        this.setQuality(this.quality)
        this.resizeListener = () => this.resetMetrics()
        app.emitter.on('onAppSizeUpdate', this.resizeListener)
        this.visibilityListener = () => {
            this.resetMetrics()
            if (!this.built) return
            if (document.hidden) app.deactivate()
            else app.activate()
        }
        document.addEventListener('visibilitychange', this.visibilityListener)
        this.load()
    }
    async load() {
        this.abort?.abort()
        this.abort = new AbortController()
        this.ui.progress.hidden = false
        this.ui.status('Cargando la oficina Tyrell…')
        try {
            this.asset = await loadTyrell(new URL(TYRELL.asset, new URL(this.app.pathPrefix, document.baseURI)).href, this.abort.signal,
                (received, total, parsing) => this.ui.status(parsing ? 'Preparando geometría, materiales y cámaras…' : `Cargando escenario · ${(received / 1e6).toFixed(1)}${total ? ' / ' + (total / 1e6).toFixed(1) : ''} MB`, total ? received / total : undefined))
            if (this.disposed) { disposeScene(this.asset.gltf.scene); return }
            this.app.emitter.emit('onProjectLoaded', {})
        } catch (error) {
            if (error.name === 'AbortError' || this.disposed) return
            console.error('[Tyrell] Carga:', error)
            // A parse/build failure must leave retry without a duplicate scene.
            disposeScene(this.asset?.gltf.scene)
            this.asset = null
            this.indirectBuild?.dispose()
            this.ui.error(error)
        }
    }
    build() {
        this.world3D = this.asset.gltf.scene
        this.scene.add(this.world3D)
        this.world3D.updateMatrixWorld(true)
        this.cameras = []
        this.shadowCasters = []
        this.modelStats = { meshes: 0, triangles: 0, cameras: 0 }
        this.world3D.traverse(object => {
            if (object.isPerspectiveCamera) this.cameras.push(object)
            if (object.isMesh) {
                this.modelStats.meshes++
                this.modelStats.triangles += (object.geometry.index?.count || object.geometry.attributes.position.count) / 3
                object.receiveShadow = true
                // Keep the distant pyramid, the sky and the sun disc out of the room's shadow
                // pass: they sit hundreds of metres away and would swallow the whole frustum.
                object.getWorldPosition(_position)
                object.castShadow = _position.length() < 50 && !FAR_AWAY.test(object.name)
                if (object.castShadow) this.shadowCasters.push(object)
            }
            if (object.isDirectionalLight) this.sun = applySunFromMaster(object)
        })
        this.applyCrystalThickness()
        this.culling = applyBackfaceCulling(this.world3D)
        this.cameras.sort((a, b) => a.name.localeCompare(b.name))
        this.modelStats.cameras = this.cameras.length
        if (!this.cameras.length) throw new Error('El GLB no contiene cámaras de perspectiva.')
        // The LTC tables have to exist before the first rect-area light is shaded on WebGPU.
        if (ltcUsers++ === 0) RectAreaLightNode.setLTC(RectAreaLightTexturesLib.init())
        this.usesLTC = true
        this.areaLights = createAreaFills()
        for (const light of this.areaLights) this.scene.add(light)
        this.shadowFit = fitSunShadow(this.sun, this.shadowCasters)
        // The scene capture has to see the direct lights already in place, so this comes last.
        this.setIndirect(this.indirect)
        this.selectCamera(Math.max(0, this.cameras.findIndex(camera => camera.name.startsWith(TYRELL.initialCamera.replaceAll(' ', '_')) || camera.name.startsWith(TYRELL.initialCamera))))
        this.setQuality(this.quality)
        this.built = true
        this.ui.ready(this.cameras, this.activeCameraIndex)
        this.resetMetrics()
    }
    // Materials are shared between the decanter, its stopper and the tumblers, so the thickness
    // is written once per material and nothing is cloned.
    applyCrystalThickness() {
        const factor = TYRELL.crystalThicknessFactor
        if (!factor) return
        const spans = new Map()
        this.world3D.traverse(object => {
            if (!object.isMesh) return
            for (const material of [].concat(object.material)) {
                if (!(material.transmission > 0) || material.thickness > 0) continue
                object.geometry.computeBoundingBox()
                _box.copy(object.geometry.boundingBox).applyMatrix4(object.matrixWorld)
                _box.getSize(_size)
                if (!spans.has(material)) spans.set(material, [])
                spans.get(material).push(Math.min(_size.x, _size.y, _size.z))
            }
        })
        this.crystalThickness = []
        for (const [material, sizes] of spans) {
            sizes.sort((a, b) => a - b)
            const median = sizes[Math.floor(sizes.length / 2)]
            material.thickness = median * factor
            this.crystalThickness.push({ material: material.name, pieces: sizes.length, medianSpan: +median.toFixed(4), thickness: +material.thickness.toFixed(4) })
        }
    }
    selectCamera(index) {
        if (!this.cameras?.[index]) return
        this.activeCameraIndex = index
        this.stageCamera.setSource(this.cameras[index])
        this.app.render.set_stageCamera(this.stageCamera.get_camera())
        this.app.dev.hide_dev_camera()
        this.resetMetrics()
    }
    setCompare(enabled) {
        this.compare = enabled
        document.body.classList.toggle('tyrell-compare', enabled)
        if (enabled) document.body.classList.add('tyrell-reference')
        this.ui.lockFrame(enabled)
        const { width, height } = TYRELL.compareSize
        this.stageCamera?.setAspect(enabled ? width / height : null)
        // setQuality reapplies the pixel ratio and resizes the render target.
        this.setQuality(this.quality)
        this.app.size.update()
    }
    // Each option is torn down before the next is built, so the room never lights itself twice
    // and no render target is left behind.
    setIndirect(mode) {
        if (!INDIRECT_MODES.includes(mode)) return
        this.indirectBuild?.dispose()
        this.indirectBuild = null
        this.scene.environment = null
        this.indirect = mode
        const centre = this.shadowFit
            ? new THREE.Vector3().fromArray(this.shadowFit.boundsMin).add(new THREE.Vector3().fromArray(this.shadowFit.boundsMax)).multiplyScalar(0.5)
            : null
        this.indirectBuild = createIndirect(mode, { renderer: this.renderer, scene: this.scene, centre })
        if (this.indirectBuild.ambient) this.scene.add(this.indirectBuild.ambient)
        this.scene.environment = this.indirectBuild.environment
        this.resetMetrics()
        return this.indirectBuild
    }
    // Contrast 1 turns the look into the identity, which is stock AgX; no shader is rebuilt.
    setLook(enabled) {
        this.look = enabled
        setLookEnabled(enabled)
        this.resetMetrics()
    }
    setQuality(name) {
        const profile = TYRELL.profiles[name]
        if (!profile) return
        this.quality = name
        // Comparison frames are pinned to 1920 x 800, so the profile only drives shadows there.
        this.renderer?.setPixelRatio(this.compare ? 1 : profile.pixelRatio)
        this.app.render?.update_resize()
        if (this.sun && this.sun.shadow.mapSize.x !== profile.shadowSize) {
            // A new light identity rebuilds r182's cached shadow nodes and bindings.
            // Keep the authored transform/target; LightShadow.clone omits GPU targets.
            const previous = this.sun
            const replacement = previous.clone(false)
            replacement.target = previous.target
            replacement.shadow.mapSize.setScalar(profile.shadowSize)
            previous.parent.add(replacement)
            previous.removeFromParent()
            previous.dispose()
            this.sun = replacement
            // The bias is expressed in texels, so a new map size needs the fit run again.
            if (this.shadowCasters?.length) this.shadowFit = fitSunShadow(this.sun, this.shadowCasters)
        }
        this.resetMetrics()
    }
    resetMetrics() {
        this.samples = []; this.warmup = 60; this.previousFrame = undefined; this.metrics = undefined
        if (this.built) this.ui.metrics('Estabilizando la medición…')
    }
    update_RAF() {
        const now = performance.now()
        if (this.previousFrame !== undefined && !document.hidden) {
            if (this.warmup > 0) this.warmup--
            else {
                this.samples.push(now - this.previousFrame)
                if (this.samples.length > 120) this.samples.shift()
            }
        }
        this.previousFrame = now
        if (this.samples.length >= 30 && (!this.lastReport || now - this.lastReport > 1000)) {
            this.lastReport = now
            const mean = this.samples.reduce((a, b) => a + b, 0) / this.samples.length
            const sorted = [...this.samples].sort((a, b) => a - b)
            const size = this.renderer.getDrawingBufferSize(new THREE.Vector2())
            this.metrics = {
                fps: +(1000 / mean).toFixed(1), frameMeanMs: +mean.toFixed(2),
                frameP95Ms: +sorted[Math.floor((sorted.length - 1) * 0.95)].toFixed(2),
                samples: this.samples.length, resolution: [size.x, size.y],
                drawCalls: this.renderer.info.render.drawCalls, renderedTriangles: this.renderer.info.render.triangles,
                geometries: this.renderer.info.memory.geometries, textures: this.renderer.info.memory.textures
            }
            this.ui.metrics(`${this.metrics.fps} FPS · ${this.metrics.frameMeanMs} ms/fotograma · ${size.x} × ${size.y} · ${this.metrics.drawCalls} dibujos · ${Math.round(this.metrics.renderedTriangles).toLocaleString('es')} triángulos/pasadas`)
        }
        if (this.captureRequested) {
            this.captureRequested = false
            this.renderer.domElement.toBlob(blob => { if (blob && !this.disposed) this.ui.showOutput(blob, this.captureName('png')) })
        }
    }
    // Evidence files must say which camera, profile and frame produced them.
    captureName(extension) {
        const camera = (this.cameras?.[this.activeCameraIndex]?.name || `camara-${this.activeCameraIndex + 1}`)
            .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
        const size = this.metrics?.resolution?.join('x') || 'sin-medir'
        return `tyrell-${camera}-${this.quality.toLowerCase()}-${this.compare ? 'comparacion' : 'ventana'}-${this.look ? 'look' : 'sinlook'}-${this.indirect}-${size}.${extension}`
    }
    getDiagnostics() {
        const camera = this.stageCamera?.get_camera()
        const info = this.renderer?.backend?.device?.adapterInfo
        return {
            phase: 4, date: new Date().toISOString(), backend: this.renderer?.backend?.isWebGPUBackend ? 'WebGPU' : 'unavailable',
            three: THREE.REVISION, userAgent: navigator.userAgent, secureContext: isSecureContext,
            adapter: info ? { vendor: info.vendor, architecture: info.architecture, device: info.device, description: info.description } : null,
            benchmarkOnStart: false, quality: this.quality, exposure: this.renderer?.toneMappingExposure,
            compare: this.compare ? { ...TYRELL.compareSize, pixelRatio: 1 } : false,
            crystal: this.crystalThickness || null,
            backfaceCulling: this.culling || null,
            toneMapping: { transform: 'AgX', look: this.look ? 'AgX - Medium High Contrast (ajustado)' : 'ninguno', ...TYRELL.look, lookApplied: this.look },
            shadowMapSize: this.sun?.shadow.mapSize.x ?? null,
            lighting: this.sun ? {
                source: 'BladeRunner_5_6_High_v3.blend, leído por tools/blender/leer_luces.py',
                sun: {
                    intensity: this.sun.intensity, color: this.sun.color.toArray().map(v => +v.toFixed(4)),
                    gltf: { intensity: this.sun.userData.gltfIntensity ?? null, color: this.sun.userData.gltfColor?.map(v => +v.toFixed(4)) ?? null },
                    note: 'El GLB trae 683 lux y blanco, ambos desfasados; en uso van los 2,25 W/m² y el ámbar del maestro.'
                },
                indirect: {
                    mode: this.indirect, modes: INDIRECT_MODES,
                    ambient: this.indirectBuild?.ambient ? { intensity: this.indirectBuild.ambient.intensity, color: this.indirectBuild.ambient.color.toArray().map(v => +v.toFixed(4)) } : null,
                    environment: this.indirectBuild?.environment ? 'PMREM' : null,
                    capturedFrom: this.indirectBuild?.capturedFrom ?? null
                },
                areaFills: this.areaLights?.map(light => ({
                    name: light.name, intensity: light.intensity, watts: light.userData.watts,
                    size: [light.width, light.height], color: light.color.toArray().map(v => +v.toFixed(4))
                })) ?? null,
                shadow: this.shadowFit || null
            } : null,
            model: this.modelStats, asset: { path: TYRELL.asset, bytes: this.asset?.bytes, loadMs: this.asset?.loadMs },
            camera: camera ? { name: camera.name, position: camera.position.toArray(), quaternion: camera.quaternion.toArray(), fov: camera.fov, aspect: camera.aspect, near: camera.near, far: camera.far } : null,
            metrics: this.metrics || null,
            metricNote: 'Intervalos RAF después de 60 fotogramas de calentamiento, ventana móvil de hasta 120 muestras. Incluyen presentación; no son tiempo GPU ni un benchmark de hardware.',
            pending: ['Iluminación indirecta', 'Reflejos del suelo', 'Atmósfera', 'Recorrido libre']
        }
    }
    downloadReport() {
        const text = JSON.stringify(this.getDiagnostics(), null, 2)
        this.ui.showOutput(new Blob([text], { type: 'application/json' }), this.captureName('json'), text)
    }
    dispose() {
        if (this.disposed) return
        this.disposed = true
        this.abort?.abort()
        this.stageCamera?.dispose()
        this.app.emitter.off('onAppKill', this.killListener)
        if (this.resizeListener) this.app.emitter.off('onAppSizeUpdate', this.resizeListener)
        document.removeEventListener('visibilitychange', this.visibilityListener)
        disposeScene(this.world3D)
        this.indirectBuild?.dispose()
        this.scene.environment = null
        this.areaLights?.forEach(light => { light.removeFromParent(); light.dispose() })
        if (this.usesLTC && --ltcUsers === 0) {
            for (const name of ['LTC_FLOAT_1', 'LTC_FLOAT_2', 'LTC_HALF_1', 'LTC_HALF_2']) RectAreaLightTexturesLib[name].dispose()
        }
        this.ui?.dispose()
        document.body.classList.remove('tyrell-viewer', 'tyrell-reference', 'tyrell-compare')
    }
}
// Everything past the room walls: hundreds of metres away, never a shadow caster.
const FAR_AWAY = /^(Tyrell_Corporation|Cielo[_ ]|Sol[_ ])/
const _position = new THREE.Vector3()
const _size = new THREE.Vector3()
const _box = new THREE.Box3()
let ltcUsers = 0

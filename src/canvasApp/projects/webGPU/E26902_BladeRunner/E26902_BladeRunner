import * as THREE from 'three'
import { vec4 } from 'three/tsl'
import { RectAreaLightNode } from 'three/webgpu'
import { RectAreaLightTexturesLib } from 'three/addons/lights/RectAreaLightTexturesLib.js'
import { TYRELL } from './config'
import { loadTyrell, disposeScene } from './TyrellAssets'
import TyrellCameraRig from './TyrellCameraRig'
import TyrellUI from './TyrellUI'
import { captureReference, REFERENCE_CAPTURE } from './TyrellCapture'
import { auditMaterialMaps } from './TyrellMaterialAudit'
import TyrellCameraPan from './TyrellCameraPan'
import TyrellLook, { applyColorReference } from './TyrellLook'
import TyrellLighting from './TyrellLighting'
import TyrellIndirect from './TyrellIndirect'
import { addColumnCores } from './TyrellColumnCores'
import { settleInstrumentCase } from './TyrellContacts'
import TyrellFloorReflection from './TyrellFloorReflection'
import TyrellSpecularEnvironment from './TyrellSpecularEnvironment'
import TyrellAtmosphere from './TyrellAtmosphere'
import TyrellLightVolume from './TyrellLightVolume'
import TyrellPostProcessing from './TyrellPostProcessing'
import TyrellComparison from './TyrellComparison'
import TyrellSky from './TyrellSky'

export default class E26902_BladeRunner {
    constructor() {
        this.type = 'WEBGPU_APP'
        this.rendererOptions = { requireWebGPU: true, benchmarkOnStart: false, powerPreference: 'high-performance' }
        this.ownsMetrics = true
        this.quality = TYRELL.quality
        this.samples = []
        this.comparison = new TyrellComparison()
        this.disposed = false
        this.lookProfile = TYRELL.materialLook
        this.exposureEV = 0
        this.studio = false
        this.lightingProfile = TYRELL.lightingProfile
    }
    mount(app) {
        if (this.ui) return
        this.app = app
        document.body.classList.add('tyrell-viewer', 'tyrell-reference')
        this.ui = new TyrellUI({
            camera: index => this.selectCamera(index), quality: name => this.setQuality(name),
            frame: enabled => { document.body.classList.toggle('tyrell-reference', enabled); app.size.update(); this.resetMetrics() },
            retry: () => this.rendererError ? location.reload() : this.load(),
            capture: () => { this.captureRequested = true }, report: () => this.downloadReport(),
            pan: settings => { this.pan?.configure(settings); this.resetMetrics() },
            center: () => { this.pan?.reset(); this.resetMetrics() },
            look: values => this.setLook(values),
            lighting: profile => this.setLighting(profile),
            reflection: enabled => { this.floorReflection?.setEnabled(enabled); this.resetMetrics() },
            reflectionMode: mode => { this.floorReflection?.setMode(mode); this.resetMetrics() },
            reflectionResolution: value => { this.floorReflection?.setResolution(value); this.resetMetrics() },
            reflectionUpdates: value => { this.floorReflection?.updates.setMode(value); this.resetMetrics() },
            specularEnvironment: enabled => { this.specularEnvironment?.setEnabled(enabled); this.resetMetrics() },
            volume: values => this.setVolume(values),
            post: values => { this.post?.configure(values); this.resetMetrics() },
            sky: enabled => { this.sky?.setEnabled(enabled); this.resetMetrics() },
            measure: () => { this.pan?.reset(); this.resetMetrics(); this.measuring = true; this.ui.comparisonStatus('Midiendo: espera sin cambiar controles ni mover la cámara…') },
            clearMeasurements: () => { this.measuring = false; this.comparison.clear(); this.ui.showMeasurements([]); this.ui.comparisonStatus('Registro vacío.') },
            exportMeasurements: () => { const text = JSON.stringify({ note: 'Intervalos RAF; no tiempo GPU. Comparar misma cámara, resolución, calidad y luz.', rows: this.comparison.rows }, null, 2); this.ui.showOutput(new Blob([text], { type: 'application/json' }), 'tyrell-comparacion.json', text) },
            atmosphere: values => { this.atmosphere?.configure(values); this.specularEnvironment?.invalidate(); this.resetMetrics() },
            indirect: mode => { this.indirect?.setMode(mode); this.setLighting(this.lightingProfile) },
            contribution: value => { this.lighting?.setContribution(value); this.indirect?.apply(this.lighting, this.studio); this.specularEnvironment?.invalidate(); this.resetMetrics() }
        })
        this.ui.setPanSettings(TYRELL.pan)
        this.ui.setEffectSettings(TYRELL.effects)
        this.ui.lightingSelect.value = this.lightingProfile
        this.ui.setLookSettings({ profile: this.lookProfile, ev: this.exposureEV, studio: this.studio })
        app.size.update()
        app.emitter.on('onAppKill', this.killListener = () => this.dispose())
    }
    onRendererProgress(app) { this.mount(app) }
    onRendererError(error, app) {
        this.mount(app)
        this.rendererError = error
        this.ui.setBackend('WebGPU no disponible')
        this.ui.error(error, true)
    }
    init(app) {
        this.mount(app)
        this.scene = app.render.scene
        this.stageCamera = new TyrellCameraRig(app)
        this.pan = new TyrellCameraPan(this.stageCamera.get_camera(), TYRELL.pan)
        this.pointerMove = event => {
            if (event.pointerType !== 'mouse' || !this.built) return
            if (event.target?.closest?.('.tyrell-gui-panel footer, .tyrell-gui-toggle, .tyrell-controls, .tyrell-pan, .tyrell-look, dialog')) { this.pan.setPointer(0, 0); return }
            if (this.measuring) this.resetMetrics()
            this.pan.setPointer(event.clientX / window.innerWidth * 2 - 1, event.clientY / window.innerHeight * 2 - 1)
        }
        this.pointerLeave = () => this.pan.setPointer(0, 0)
        this.windowBlur = () => { this.pan.reset(); this.panTime = undefined }
        window.addEventListener('pointermove', this.pointerMove)
        document.documentElement.addEventListener('pointerleave', this.pointerLeave)
        window.addEventListener('blur', this.windowBlur)
        this.renderer = app.render.renderer
        this.colorReference = applyColorReference(this.renderer, this.exposureEV)
        this.post = new TyrellPostProcessing(this.renderer, this.scene)
        this.renderer.shadowMap.enabled = true
        this.renderer.shadowMap.type = THREE.PCFShadowMap
        this.renderer.shadowMap.transmitted = true
        this.renderer.setClearColor(0x171512, 1)
        this.ui.setBackend(`WebGPU · Three.js r${THREE.REVISION}`)
        this.setQuality(this.quality)
        this.resizeListener = () => this.resetMetrics()
        app.emitter.on('onAppSizeUpdate', this.resizeListener)
        this.visibilityListener = () => {
            this.windowBlur()
            this.resetMetrics()
            if (!this.built) return
            if (document.hidden) app.deactivate()
            else app.activate()
        }
        document.addEventListener('visibilitychange', this.visibilityListener)
        this.load()
    }
    async load() {
        this.abort?.abort()
        this.abort = new AbortController()
        this.ui.progress.hidden = false
        this.ui.status('Cargando la oficina Tyrell…')
        try {
            this.asset = await loadTyrell(new URL(TYRELL.asset, new URL(this.app.pathPrefix, document.baseURI)).href, this.abort.signal,
                (received, total, parsing) => this.ui.status(parsing ? 'Preparando geometría, materiales y cámaras…' : `Cargando escenario · ${(received / 1e6).toFixed(1)}${total ? ' / ' + (total / 1e6).toFixed(1) : ''} MB`, total ? received / total : undefined))
            if (this.disposed) { disposeScene(this.asset.gltf.scene); return }
            this.skyTexture = await new THREE.TextureLoader().loadAsync(new URL('textures/E26902_BladeRunner/sky-panorama-v2.png', new URL(this.app.pathPrefix, document.baseURI)).href)
            this.skyTexture.colorSpace = THREE.SRGBColorSpace
            this.skyTexture.wrapS = THREE.RepeatWrapping
            if (this.disposed) { this.skyTexture.dispose(); disposeScene(this.asset.gltf.scene); return }
            this.app.emitter.emit('onProjectLoaded', {})
        } catch (error) {
            if (error.name === 'AbortError' || this.disposed) return
            console.error('[Tyrell] Carga:', error)
            // A parse/build failure must leave retry without a duplicate scene.
            disposeScene(this.asset?.gltf.scene)
            this.asset = null
            this.fill?.removeFromParent()
            this.ui.error(error)
        }
    }
    build() {
        this.world3D = this.asset.gltf.scene
        this.columnCores = addColumnCores(this.world3D)
        this.contactRepair = settleInstrumentCase(this.world3D)
        this.floorReflection = new TyrellFloorReflection(this.world3D)
        this.scene.add(this.world3D)
        this.world3D.updateMatrixWorld(true)
        this.materialAudit = auditMaterialMaps(this.world3D)
        this.look = new TyrellLook(this.world3D)
        this.cameras = []
        this.modelStats = { meshes: 0, triangles: 0, cameras: 0 }
        this.world3D.traverse(object => {
            if (object.isPerspectiveCamera) this.cameras.push(object)
            if (object.isMesh) {
                this.modelStats.meshes++
                this.modelStats.triangles += (object.geometry.index?.count || object.geometry.attributes.position.count) / 3
                object.receiveShadow = true
                // Keep the distant pyramid/sky out of the room's shadow pass.
                object.getWorldPosition(_position)
                object.castShadow = _position.length() < 50
                const materials = Array.isArray(object.material) ? object.material : [object.material]
                for (const material of materials) {
                    if (material.name === 'Crystal') material.castShadowNode = vec4(0, 0, 0, TYRELL.shadows.glassOpacity)
                }
            }
            if (object.isDirectionalLight) {
                this.sun = object
                object.userData.exportedIntensity = object.intensity
                object.intensity = TYRELL.sunIntensity
                object.castShadow = true
                Object.assign(object.shadow.camera, TYRELL.shadows.camera)
                object.shadow.bias = TYRELL.shadows.bias
                object.shadow.normalBias = TYRELL.shadows.normalBias
                object.shadow.radius = TYRELL.shadows.radius
                object.shadow.camera.updateProjectionMatrix()
            }
        })
        this.cameras.sort((a, b) => a.name.localeCompare(b.name))
        this.modelStats.cameras = this.cameras.length
        if (!this.cameras.length) throw new Error('El GLB no contiene cámaras de perspectiva.')
        this.fill = new THREE.HemisphereLight(0xffdab0, 0x797e8a, TYRELL.hemisphereIntensity)
        this.fill.name = 'Tyrell / relleno provisional'
        this.scene.add(this.fill)
        if (ltcUsers++ === 0) RectAreaLightNode.setLTC(RectAreaLightTexturesLib.init())
        this.usesLTC = true
        this.areaLights = TYRELL.areaFills.map(({ position, target, color, intensity, size }) => {
            const light = new THREE.RectAreaLight(color, intensity, size, size)
            light.name = 'Tyrell / área provisional'
            light.position.set(...position)
            light.lookAt(new THREE.Vector3(...target))
            this.scene.add(light)
            return light
        })
        this.lighting = new TyrellLighting(this.world3D, this.sun, this.fill, this.areaLights)
        this.indirect = new TyrellIndirect(this.scene)
        this.specularEnvironment = new TyrellSpecularEnvironment(this.scene, this.world3D, this.floorReflection)
        this.volume = new TyrellLightVolume(() => this.sun)
        this.atmosphere = new TyrellAtmosphere(this.scene, this.world3D, this.volume)
        this.sky = new TyrellSky(this.scene, this.lighting.sky, this.skyTexture)
        this.setLighting(this.lightingProfile)
        this.studioLights = new THREE.Group()
        this.studioLights.name = 'Tyrell / estudio de materiales'
        this.studioLights.add(new THREE.HemisphereLight(0xffffff, 0x777777, 1.2))
        for (const [position, target, intensity] of [
            [[-5, 6, -5], [0, 1, -9], 3], [[6, 4, -12], [0, 1, -8], 1.5]
        ]) {
            const light = new THREE.RectAreaLight(0xffffff, intensity, 8, 8)
            light.position.set(...position); light.lookAt(new THREE.Vector3(...target)); this.studioLights.add(light)
        }
        this.scene.add(this.studioLights)
        this.reviewBackground = []
        this.world3D.traverse(object => {
            if (object.isMesh && (object.name.startsWith('Cielo') || object.name.startsWith('Sol'))) {
                this.reviewBackground.push({ object, visible: object.visible })
            }
        })
        this.setLook({ profile: this.lookProfile, studio: this.studio })
        this.selectCamera(Math.max(0, this.cameras.findIndex(camera => camera.name.startsWith(TYRELL.initialCamera.replaceAll(' ', '_')) || camera.name.startsWith(TYRELL.initialCamera))))
        this.setQuality(this.quality)
        this.built = true
        this.floorReflection.setEnabled(TYRELL.effects.floorReflection)
        this.specularEnvironment.setEnabled(TYRELL.effects.specularEnvironment)
        this.atmosphere.configure({ exterior: TYRELL.effects.exterior, interior: TYRELL.effects.interior })
        this.setVolume({ enabled: TYRELL.effects.volume })
        this.post.configure({ bloom: TYRELL.effects.bloom, grade: TYRELL.effects.grade })
        this.ui.ready(this.cameras, this.activeCameraIndex)
        this.resetMetrics()
    }
    selectCamera(index) {
        if (!this.cameras?.[index]) return
        this.activeCameraIndex = index
        this.stageCamera.setSource(this.cameras[index])
        this.pan?.setReference()
        this.app.render.set_stageCamera(this.stageCamera.get_camera())
        this.app.dev.hide_dev_camera()
        this.resetMetrics()
    }
    setVolume(values) {
        if (!this.volume || !this.atmosphere) return
        this.volume.configure(values)
        this.atmosphere.refreshVolume()
        this.specularEnvironment.invalidate()
        this.resetMetrics()
    }
    renderFrame(camera) {
        if (this.post) this.post.render(camera)
        else this.renderer.render(this.scene, camera)
    }
    setLighting(profile) {
        this.specularEnvironment?.invalidate()
        if (!['provisional', 'tyrell-light-v1', 'tyrell-light-v2', 'tyrell-light-v3'].includes(profile)) return
        this.lightingProfile = profile
        this.lighting?.apply(profile)
        this.indirect?.apply(this.lighting, this.studio)
        this.resetMetrics()
    }
    setLook(values) {
        this.specularEnvironment?.invalidate()
        if (['imported', 'tyrell-v1'].includes(values.profile)) {
            this.lookProfile = values.profile
            this.look?.apply(this.lookProfile)
            if (this.world3D) this.materialAudit = auditMaterialMaps(this.world3D)
        }
        if (typeof values.floorNormal === 'boolean') {
            this.look?.setFloorNormal(values.floorNormal)
            if (this.world3D) this.materialAudit = auditMaterialMaps(this.world3D)
        }
        if (Number.isFinite(values.ev)) this.exposureEV = Math.max(-2, Math.min(2, values.ev))
        if (this.renderer) this.colorReference = applyColorReference(this.renderer, this.exposureEV)
        if (typeof values.studio === 'boolean') {
            this.studio = values.studio
            this.sky?.setStudio(this.studio)
            if (this.lighting) { this.lighting.apply(this.lightingProfile); this.indirect?.apply(this.lighting, this.studio) }
        }
        if (this.studioLights) {
            this.studioLights.visible = this.studio
            if (this.sun) this.sun.visible = !this.studio
            this.fill.visible = !this.studio
            this.areaLights.forEach(light => { light.visible = !this.studio })
            this.reviewBackground.forEach(({ object, visible }) => { object.visible = !this.studio && visible })
            this.sky?.apply()
            this.renderer.setClearColor(this.studio ? 0x202020 : 0x171512, 1)
        }
        this.resetMetrics()
    }
    setQuality(name) {
        const profile = TYRELL.profiles[name]
        if (!profile) return
        this.quality = name
        this.volume?.setQuality(name)
        this.post?.setQuality(name)
        this.floorReflection?.setResolution(this.floorReflection.resolution, name)
        this.specularEnvironment?.invalidate()
        this.renderer?.setPixelRatio(profile.pixelRatio)
        this.app.render?.update_resize()
        if (this.sun && this.sun.shadow.mapSize.x !== profile.shadowSize) {
            // A new light identity rebuilds r182's cached shadow nodes and bindings.
            // Keep the authored transform/target; LightShadow.clone omits GPU targets.
            const previous = this.sun
            const replacement = previous.clone(false)
            replacement.target = previous.target
            replacement.shadow.mapSize.setScalar(profile.shadowSize)
            previous.parent.add(replacement)
            previous.removeFromParent()
            previous.dispose()
            this.sun = replacement
            if (this.lighting) this.lighting.sun = replacement
        }
        this.resetMetrics()
    }
    resetMetrics() {
        if (this.measuring) this.ui.comparisonStatus('Medición cancelada por un cambio de configuración. Vuelve a medir.')
        this.measuring = false
        this.floorReflection?.updates.invalidate()
        this.samples = []; this.warmup = 60; this.previousFrame = undefined; this.metrics = undefined
        if (this.built) this.ui.metrics('Estabilizando la medición…')
    }
    update_RAF() {
        const now = performance.now()
        const volumeNode = this.volume?.node
        if (this.volume?.update(this.panTime === undefined ? 0 : (now - this.panTime) / 1000)) this.floorReflection?.updates.invalidate()
        if (this.volume?.node !== volumeNode) { this.atmosphere.refreshVolume(); this.specularEnvironment.invalidate(); this.resetMetrics() }
        if (this.sky) this.sky.withOriginalBackground(() => this.specularEnvironment?.update(this.renderer))
        else this.specularEnvironment?.update(this.renderer)
        this.pan?.update(this.panTime === undefined ? 0 : (now - this.panTime) / 1000)
        this.panTime = now
        if (this.previousFrame !== undefined && !document.hidden) {
            if (this.warmup > 0) this.warmup--
            else {
                this.samples.push(now - this.previousFrame)
                if (this.samples.length > 120) this.samples.shift()
            }
        }
        this.previousFrame = now
        if (this.samples.length >= 30 && (!this.lastReport || now - this.lastReport > 1000)) {
            this.lastReport = now
            const mean = this.samples.reduce((a, b) => a + b, 0) / this.samples.length
            const sorted = [...this.samples].sort((a, b) => a - b)
            const size = this.renderer.getDrawingBufferSize(new THREE.Vector2())
            this.metrics = {
                fps: +(1000 / mean).toFixed(1), frameMeanMs: +mean.toFixed(2),
                frameP95Ms: +sorted[Math.floor((sorted.length - 1) * 0.95)].toFixed(2),
                samples: this.samples.length, resolution: [size.x, size.y],
                drawCalls: this.renderer.info.render.drawCalls, renderedTriangles: this.renderer.info.render.triangles,
                geometries: this.renderer.info.memory.geometries, textures: this.renderer.info.memory.textures
            }
            this.ui.metrics(`${this.metrics.fps} FPS · ${this.metrics.frameMeanMs} ms/fotograma · ${size.x} × ${size.y} · ${this.metrics.drawCalls} dibujos · ${Math.round(this.metrics.renderedTriangles).toLocaleString('es')} triángulos/pasadas`)
            if (this.measuring && this.metrics.samples === 120) {
                this.measuring = false
                this.comparison.add(this.getDiagnostics())
                this.ui.showMeasurements(this.comparison.rows)
                this.ui.comparisonStatus('Medición guardada. Cambia un efecto y vuelve a medir; conserva cámara, calidad y encuadre.')
            }
        }
        if (this.captureRequested) {
            this.captureRequested = false
            const camera = this.activeCameraIndex + 1
            const atmosphere = this.atmosphere.settings
            const filename = `tyrell-camara-${camera}-${this.lookProfile}-${this.studio ? 'estudio' : 'escena'}-${this.lightingProfile}-${this.indirect?.mode || 'reference'}-${this.lighting.contribution || 'all'}-EV${this.exposureEV}-normal${this.look.floorNormal ? 'on' : 'off'}-reflejo${this.floorReflection.enabled ? 'on' : 'off'}-${this.floorReflection.mode}-ext${atmosphere.exterior ? atmosphere.exteriorStrength : 0}-int${atmosphere.interior ? atmosphere.interiorStrength : 0}-volume${this.volume.settings.enabled ? this.volume.settings.strength : 0}-dust${this.volume.settings.dust ? this.volume.settings.speed : 0}-1920x800.png`
            captureReference(this.renderer, this.scene, this.pan.referenceCamera, camera => this.renderFrame(camera))
                .then(blob => { if (!this.disposed) this.ui.showOutput(blob, filename.replace('-1920x800', `-bloom${this.post.settings.bloom ? this.post.settings.strength : 0}-grade${this.post.settings.grade ? this.post.settings.gradeStrength : 0}-1920x800`)) })
                .catch(error => {
                    console.error('[Tyrell] Captura:', error)
                    if (!this.disposed) this.ui.showOutput(new Blob([error.message], { type: 'text/plain' }), 'tyrell-error-captura.txt', error.message)
                })
            this.resetMetrics()
        }
    }
    getDiagnostics() {
        const camera = this.stageCamera?.get_camera()
        const info = this.renderer?.backend?.device?.adapterInfo
        return {
            phase: 6, step: '6.7', date: new Date().toISOString(), backend: this.renderer?.backend?.isWebGPUBackend ? 'WebGPU' : 'unavailable',
            referenceCapture: { ...REFERENCE_CAPTURE, aspect: 2.4 },
            three: THREE.REVISION, userAgent: navigator.userAgent, secureContext: isSecureContext,
            adapter: info ? { vendor: info.vendor, architecture: info.architecture, device: info.device, description: info.description } : null,
            benchmarkOnStart: false, quality: this.quality, exposure: this.renderer?.toneMappingExposure,
            model: this.modelStats, asset: { path: TYRELL.asset, bytes: this.asset?.bytes, loadMs: this.asset?.loadMs },
            columnRepair: this.columnCores?.userData.columnRepair || null,
            contactRepair: this.contactRepair || null,
            floorReflection: this.floorReflection?.diagnostics() || null,
            specularEnvironment: this.specularEnvironment?.diagnostics() || null,
            atmosphere: this.atmosphere?.diagnostics() || null,
            lightVolume: this.volume?.diagnostics() || null,
            postProcessing: this.post?.diagnostics() || null,
            sky: this.sky?.diagnostics() || null,
            comparison: this.comparison.rows,
            optionalFinish: { grain: false, vignette: false, depthOfField: false, decision: '6.6: retain clean image; preserve stone, floor reflections and architectural depth' },
            materialAudit: this.materialAudit || null,
            colorReference: this.colorReference,
            lighting: this.lighting?.diagnostics(),
            indirect: this.indirect?.diagnostics(),
            shadows: { ...TYRELL.shadows, mapSize: this.sun?.shadow.mapSize.toArray(), transmitted: this.renderer.shadowMap.transmitted },
            materialLook: this.look?.diagnostics(), reviewLighting: this.studio ? 'neutral-studio' : this.lightingProfile,
            cameraPan: this.pan?.diagnostics() || null,
            camera: camera ? { name: camera.name, position: camera.position.toArray(), quaternion: camera.quaternion.toArray(), fov: camera.fov, aspect: camera.aspect, near: camera.near, far: camera.far } : null,
            metrics: this.metrics || null,
            metricNote: 'Intervalos RAF después de 60 fotogramas de calentamiento, ventana móvil de hasta 120 muestras. Incluyen presentación; no son tiempo GPU ni un benchmark de hardware.',
            pending: ['Materiales y luz definitiva', 'Reflejos del suelo', 'Atmósfera', 'Recorrido libre']
        }
    }
    downloadReport() {
        const text = JSON.stringify(this.getDiagnostics(), null, 2)
        this.ui.showOutput(new Blob([text], { type: 'application/json' }), 'tyrell-diagnostico.json', text)
    }
    dispose() {
        if (this.disposed) return
        this.disposed = true
        this.abort?.abort()
        window.removeEventListener('pointermove', this.pointerMove)
        document.documentElement.removeEventListener('pointerleave', this.pointerLeave)
        window.removeEventListener('blur', this.windowBlur)
        this.stageCamera?.dispose()
        this.app.emitter.off('onAppKill', this.killListener)
        if (this.resizeListener) this.app.emitter.off('onAppSizeUpdate', this.resizeListener)
        document.removeEventListener('visibilitychange', this.visibilityListener)
        this.specularEnvironment?.dispose()
        this.post?.dispose()
        this.sky?.dispose()
        this.atmosphere?.dispose()
        this.volume?.dispose()
        this.floorReflection?.dispose()
        disposeScene(this.world3D)
        this.fill?.removeFromParent()
        this.fill?.dispose()
        this.indirect?.dispose()
        this.areaLights?.forEach(light => { light.removeFromParent(); light.dispose() })
        this.studioLights?.traverse(object => { if (object.isLight) object.dispose() })
        this.studioLights?.removeFromParent()
        this.look?.original.clear()
        if (this.usesLTC && --ltcUsers === 0) {
            for (const name of ['LTC_FLOAT_1', 'LTC_FLOAT_2', 'LTC_HALF_1', 'LTC_HALF_2']) RectAreaLightTexturesLib[name].dispose()
        }
        this.ui?.dispose()
        document.body.classList.remove('tyrell-viewer', 'tyrell-reference')
    }
}
const _position = new THREE.Vector3()
let ltcUsers = 0
